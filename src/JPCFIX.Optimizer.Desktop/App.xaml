<Application x:Class="JPCFIX.Optimizer.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#172235" />
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5ECF6" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,4" /></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#2457A6" /><Setter Property="Foreground" Value="White" /><Setter Property="Padding" Value="16,10" /><Setter Property="Margin" Value="0,6,12,6" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style TargetType="DataGrid">
   <Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#111827" /><Setter Property="Margin" Value="4" /></Style></Style.Resources>
   <Setter Property="Background" Value="#172235" /><Setter Property="Foreground" Value="#111827" /><Setter Property="RowBackground" Value="#EDF2FA" /><Setter Property="AlternatingRowBackground" Value="#DAE4F3" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="True" /><Setter Property="CanUserAddRows" Value="False" />
  </Style>
  <Style TargetType="ComboBox"><Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#111827" /></Style></Style.Resources><Setter Property="Foreground" Value="#111827" /><Setter Property="Padding" Value="8" /></Style>
 </Application.Resources>
</Application>
