<UserControl x:Class="JPCFIX.Optimizer.Desktop.OptimizationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JPCFIX.Optimizer.Desktop">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PagePadding}"><TextBlock Text="Optimizaciones" Style="{StaticResource PageTitle}"/><TextBlock Text="Revisá el estado, simulá el cambio y confirmá antes de modificar Windows." Style="{StaticResource SecondaryText}" Margin="0,0,0,20"/>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Cambio controlado de plan de energía" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Badge}" Margin="0,4,0,14"><TextBlock Text="Riesgo moderado · Administrador al aplicar · Sin reinicio" FontSize="12"/></Border><TextBlock Text="{Binding PowerStatus}" LineHeight="22"/><TextBlock Text="Seleccioná una alternativa existente" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Plans}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPlan}" MaxWidth="600" HorizontalAlignment="Left" MinWidth="250"/><WrapPanel Margin="0,10,0,0"><Button Content="Actualizar planes" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Simular (DryRun)" Command="{Binding PreviewCommand}"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Previsualización del cambio" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding PreviewText}" LineHeight="23" Margin="0,8"/><Button Content="Aplicar con confirmación…" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource WarningPanel}"><DockPanel><local:AppIcon Kind="Warning" Foreground="{DynamicResource WarningBrush}" Margin="0,0,14,0" VerticalAlignment="Top"/><TextBlock Text="Un plan diferente puede aumentar consumo, ruido y temperatura. No se crean planes ni se desactivan funciones de seguridad. El ejecutor vuelve a validar y solicita confirmación antes de modificar Windows." LineHeight="22"/></DockPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
