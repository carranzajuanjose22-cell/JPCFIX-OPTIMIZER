<Window x:Class="JPCFIX.Optimizer.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JPCFIX Optimizer" Width="1180" Height="780" MinWidth="850" MinHeight="600" Background="#0C1422" FontFamily="Segoe UI" FontSize="14">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="JPCFIX  /  OPTIMIZER" FontSize="28" FontWeight="Bold" /><TextBlock Text="Herramientas técnicas · Windows 10 / 11" Foreground="#92B5EA" /><TextBlock Text="{Binding Status}" Margin="0,12" /><ProgressBar Height="3" IsIndeterminate="{Binding Busy}" /></StackPanel>
  <TabControl SelectedIndex="{Binding Page}" Background="#172235" Margin="0,16,0,0">
   <TabItem Header="Inicio"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Diagnóstico antes de cada cambio" FontSize="24" /><TextBlock Text="{Binding Summary}" /><TextBlock Text="{Binding Recommendations}" /><WrapPanel><Button Content="Analizar equipo" Command="{Binding ScanCommand}" /><Button Content="Ver optimizaciones" Command="{Binding OptimizePageCommand}" /><Button Content="Historial" Command="{Binding HistoryPageCommand}" /></WrapPanel><TextBlock Text="Solo se ofrece el cambio de plan de energía. Un plan diferente puede aumentar consumo, ruido y temperatura. Evaluá los resultados con cargas representativas." /></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Diagnóstico"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><Button Content="Actualizar diagnóstico" Command="{Binding ScanCommand}" HorizontalAlignment="Left" /><TextBlock Grid.Row="1" Text="{Binding Warnings}" /><DataGrid Grid.Row="2" ItemsSource="{Binding Diagnostics}" /></Grid></TabItem>
   <TabItem Header="Optimizaciones"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Cambio controlado de plan de energía" FontSize="24" /><TextBlock Text="Riesgo moderado · Requiere administrador · Sin reinicio" /><TextBlock Text="{Binding PowerStatus}" /><TextBlock Text="Seleccioná una alternativa existente:" /><ComboBox ItemsSource="{Binding Plans}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPlan}" MinWidth="280" HorizontalAlignment="Left" /><WrapPanel><Button Content="Actualizar planes" Command="{Binding RefreshCommand}" /><Button Content="Simular (DryRun)" Command="{Binding PreviewCommand}" /></WrapPanel><Border Background="#0C1422" Padding="16" Margin="0,12"><TextBlock Text="{Binding PreviewText}" /></Border><Button Content="Aplicar con confirmación…" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" /><TextBlock Text="No se crean planes ni se desactivan funciones de seguridad. El ejecutor vuelve a validar y solicita confirmación antes de modificar Windows." /></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Historial"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><WrapPanel><Button Content="Actualizar historial" Command="{Binding HistoryCommand}" /><Button Content="Revertir / recuperar selección…" Command="{Binding RollbackCommand}" /></WrapPanel><TextBlock Grid.Row="1" Text="Prepared / RecoveryRequired indican operaciones incompletas. Seleccionalas y solicitá recuperación. Las fechas se muestran con su zona UTC original." /><DataGrid Grid.Row="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedChange}" /></Grid></TabItem>
   <TabItem Header="Configuración"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="JPCFIX Optimizer · 0.1.0" FontSize="24" /><TextBlock Text="El registro de cambios y respaldos es obligatorio. Los reportes de diagnóstico son opcionales y se exportan únicamente bajo solicitud." /><TextBlock Text="Directorio de reportes (local y persistente):" /><TextBox Text="{Binding ReportDirectory, UpdateSourceTrigger=PropertyChanged}" /><WrapPanel><Button Content="Guardar configuración" Command="{Binding SaveSettingsCommand}" /><Button Content="Exportar diagnóstico JSON" Command="{Binding ExportCommand}" /></WrapPanel><TextBlock Text="{Binding StorageText}" /><TextBlock Text="Puntos de restauración: mecanismo adicional sujeto a protección del sistema, permisos y límites de Windows." /><Button Content="Detectar puntos de restauración" Command="{Binding DetectRestoreCommand}" HorizontalAlignment="Left" /><TextBlock Text="{Binding RestoreStatus}" /><Button Content="Solicitar punto adicional…" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" /><TextBlock Text="Los reportes contienen nombre del equipo y procesos. Guardalos en una ubicación de confianza. Conservá todos los archivos de la carpeta portable y ejecutá solo binarios de origen confiable." /></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
