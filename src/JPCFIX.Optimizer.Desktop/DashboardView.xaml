<UserControl x:Class="JPCFIX.Optimizer.Desktop.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JPCFIX.Optimizer.Desktop">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="{StaticResource PagePadding}">
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Height="44" Width="44" VerticalAlignment="Top"><local:AppIcon Kind="Monitor" Width="30" Height="30"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Diagnóstico antes de cada cambio" Style="{StaticResource PageTitle}"/><TextBlock Text="Analizá el estado del equipo para obtener recomendaciones seguras y efectivas." Style="{StaticResource SecondaryText}"/></StackPanel></Grid>
  <Border Style="{StaticResource InfoPanel}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:AppIcon Kind="Info" Width="27" Height="27"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding AnalysisHeading}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Dashboard.Notice}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
  <local:AdaptivePanel MaxColumns="4" MinColumnWidth="180" Margin="0,0,0,16"><local:MetricCard Title="CPU" Value="{Binding Dashboard.Cpu}" Description="{Binding Dashboard.CpuDescription}" Icon="Cpu"/><local:MetricCard Title="RAM" Value="{Binding Dashboard.Ram}" Description="Memoria instalada" Icon="Ram"/><local:MetricCard Title="Almacenamiento" Value="{Binding Dashboard.Storage}" Description="{Binding Dashboard.StorageDescription}" Icon="Storage"/><local:MetricCard Title="Estado general" Value="{Binding Dashboard.General}" Description="{Binding Dashboard.GeneralDescription}" Icon="Shield"/></local:AdaptivePanel>
  <local:AdaptivePanel MinColumnWidth="350" Margin="0,0,0,16">
   <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,8"><local:AppIcon Kind="Bolt" Width="27" Height="27" Margin="0,0,12,0" VerticalAlignment="Top"/><StackPanel><TextBlock Text="Acciones rápidas" Style="{StaticResource SectionTitle}"/><TextBlock Text="Analizá, evaluá los cambios y revisá las operaciones registradas." Style="{StaticResource SecondaryText}"/></StackPanel></DockPanel><WrapPanel Margin="0,12,0,0"><Button AutomationProperties.Name="Analizar equipo" Command="{Binding ScanCommand}" Padding="12,10" FontSize="13"><StackPanel Orientation="Horizontal"><local:AppIcon Kind="Play" Foreground="White" Width="18" Height="18" Margin="0,0,9,0"/><TextBlock Text="Analizar equipo"/></StackPanel></Button><Button Content="Ver optimizaciones" Padding="12,10" FontSize="13" Style="{StaticResource SecondaryButton}" Command="{Binding OptimizePageCommand}"/><Button Content="Historial" Padding="12,10" FontSize="13" Style="{StaticResource SecondaryButton}" Command="{Binding HistoryPageCommand}"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,10"><local:AppIcon Kind="Monitor" Margin="0,0,12,0"/><TextBlock Text="Detalles del sistema" Style="{StaticResource SectionTitle}"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Windows" Style="{StaticResource SecondaryText}" Margin="0,6"/><TextBlock Grid.Column="1" Text="{Binding Dashboard.Windows}" Margin="0,6"/><TextBlock Grid.Row="1" Text="Procesador" Style="{StaticResource SecondaryText}" Margin="0,6"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dashboard.Processor}" Margin="0,6"/><TextBlock Grid.Row="2" Text="Memoria RAM" Style="{StaticResource SecondaryText}" Margin="0,6"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Dashboard.Ram}" Margin="0,6"/><TextBlock Grid.Row="3" Text="Almacenamiento" Style="{StaticResource SecondaryText}" Margin="0,6"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Dashboard.StorageDetail}" Margin="0,6"/></Grid></StackPanel></Border>
  </local:AdaptivePanel>
  <local:AdaptivePanel MinColumnWidth="350">
   <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12"><local:AppIcon Kind="Settings" Margin="0,0,12,0"/><TextBlock Text="Optimización disponible" Style="{StaticResource SectionTitle}"/></DockPanel><Border Style="{StaticResource WarningPanel}" Padding="14"><StackPanel><TextBlock Text="{Binding OptimizationName}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding OptimizationDescription}" Style="{StaticResource SecondaryText}" Margin="0,6"/><TextBlock Text="{Binding OptimizationRisk, StringFormat=Riesgo: {0}}" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="{Binding OptimizationAvailability}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel></Border><Button Content="Revisar configuración →" Command="{Binding OptimizePageCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12"><local:AppIcon Kind="History" Margin="0,0,12,0"/><TextBlock Text="Actividad reciente" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="Sin actividad registrada"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl ItemsSource="{Binding RecentActivity}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><Border Style="{StaticResource OperationBadge}"><TextBlock Text="{Binding Status, Converter={StaticResource ChangeStatusText}}" FontSize="12"/></Border><TextBlock Text="{Binding CreatedAt, StringFormat=g}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/><TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </local:AdaptivePanel>
 </StackPanel></ScrollViewer>
</UserControl>
