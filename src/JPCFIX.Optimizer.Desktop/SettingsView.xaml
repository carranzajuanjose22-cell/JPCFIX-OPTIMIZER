<UserControl x:Class="JPCFIX.Optimizer.Desktop.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PagePadding}"><TextBlock Text="Configuración" Style="{StaticResource PageTitle}"/><TextBlock Text="Reportes, persistencia y mecanismos adicionales de recuperación." Style="{StaticResource SecondaryText}" Margin="0,0,0,20"/>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Reportes de diagnóstico" Style="{StaticResource SectionTitle}"/><TextBlock Text="Se exportan únicamente bajo solicitud. Elegí una ubicación local persistente y de confianza." Style="{StaticResource SecondaryText}"/><TextBlock Text="Directorio de reportes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReportDirectory, UpdateSourceTrigger=PropertyChanged}"/><WrapPanel Margin="0,8,0,0"><Button Content="Guardar configuración" Command="{Binding SaveSettingsCommand}"/><Button Content="Exportar diagnóstico JSON" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Registro y almacenamiento" Style="{StaticResource SectionTitle}"/><TextBlock Text="El registro de cambios y sus respaldos es obligatorio. Smart Backup guarda datos personales en el destino que elijas." Style="{StaticResource SecondaryText}"/><TextBlock Text="{Binding StorageText}" Margin="0,12,0,0" LineHeight="23"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Puntos de restauración de Windows" Style="{StaticResource SectionTitle}"/><TextBlock Text="Mecanismo adicional sujeto a protección del sistema, permisos y límites de Windows. No sustituye el respaldo de datos." Style="{StaticResource SecondaryText}"/><WrapPanel Margin="0,10,0,0"><Button Content="Detectar puntos de restauración" Command="{Binding DetectRestoreCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Solicitar punto adicional…" Command="{Binding RestoreCommand}"/></WrapPanel><TextBlock Text="{Binding RestoreStatus}" Margin="0,10,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource InfoPanel}"><TextBlock Text="Los reportes contienen nombre del equipo y procesos. Conservá todos los archivos del paquete portable y ejecutá únicamente binarios de origen confiable."/></Border>
 </StackPanel></ScrollViewer>
</UserControl>
