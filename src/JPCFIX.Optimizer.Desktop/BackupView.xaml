<UserControl x:Class="JPCFIX.Optimizer.Desktop.BackupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JPCFIX.Optimizer.Desktop">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="{StaticResource PagePadding}">
  <TextBlock Text="Smart Backup" Style="{StaticResource PageTitle}"/><TextBlock Text="Protegé los datos personales y recuperalos después de reinstalar Windows." Style="{StaticResource SecondaryText}" Margin="0,0,0,18"/>
  <local:AdaptivePanel MinColumnWidth="300" Margin="0,0,0,18">
   <Button AutomationProperties.Name="Crear nuevo respaldo" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:AppIcon Kind="Database" Width="26" Height="26" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Crear nuevo respaldo" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Analizar · seleccionar · copiar y verificar" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel></Grid></Button>
   <Button AutomationProperties.Name="Restaurar respaldo existente" Command="{Binding ExistingCommand}" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:AppIcon Kind="History" Width="26" Height="26" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Restaurar respaldo existente" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Verificar · previsualizar · recuperar" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel></Grid></Button>
  </local:AdaptivePanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Usuario autorizado" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ProfileText}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Profiles}" SelectedIndex="0" DisplayMemberPath="Name" IsEnabled="{Binding Ready}" MaxWidth="540" HorizontalAlignment="Left" MinWidth="220"/></StackPanel></Border>
  <Border Style="{StaticResource InfoPanel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="15" LineHeight="22"/><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ProgressText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><ProgressBar IsIndeterminate="{Binding Busy}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0"/><TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" Margin="0,10,0,6"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="6"/><TextBlock Text="Archivo actual" Style="{StaticResource SecondaryText}" Margin="0,8,0,5"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding FilePercent, Mode=OneWay}" Height="3"/><Button Content="Cancelar operación" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></StackPanel></Border>
  <TabControl SelectedIndex="{Binding Workflow}">
   <TabItem Header="Crear respaldo"><StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="1 · Seleccioná el contenido" Style="{StaticResource SectionTitle}"/><TextBlock Text="Incluí únicamente información autorizada. Las cifras se completan al analizar la selección." Style="{StaticResource SecondaryText}" Margin="0,0,0,10"/><WrapPanel><Button Content="Detectar carpetas del usuario" Command="{Binding DetectCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Reemplaza la lista por las carpetas detectadas del usuario."/><Button Content="Seleccionar recomendadas" Command="{Binding RecommendedCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Agregar carpeta" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Agregar archivo" Command="{Binding AddFileCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Analizar selección" Command="{Binding AnalyzeCommand}"/></WrapPanel>
     <DataGrid ItemsSource="{Binding Sources}" Height="250" AutoGenerateColumns="False" IsReadOnly="False" IsEnabled="{Binding Ready}" Margin="0,10,0,14" AutomationProperties.Name="Categorías del respaldo"><DataGrid.Columns><DataGridCheckBoxColumn Header="Incluir" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="64"/><DataGridTextColumn Header="Categoría" Binding="{Binding Name}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="Ubicación detectada" Binding="{Binding Path}" IsReadOnly="True" Width="260"/><DataGridTextColumn Header="Bytes estimados" Binding="{Binding Bytes, StringFormat=N0}" IsReadOnly="True" Width="135"/><DataGridTextColumn Header="Archivos" Binding="{Binding Files}" IsReadOnly="True" Width="85"/><DataGridTextColumn Header="Accesibilidad" Binding="{Binding State}" IsReadOnly="True" Width="230"/><DataGridTextColumn Header="Advertencias" Binding="{Binding Warning}" IsReadOnly="True" Width="320"/></DataGrid.Columns></DataGrid>
     <TextBlock Text="Posibles archivos personales fuera de las carpetas habituales" FontWeight="SemiBold"/><TextBlock Text="Agregá manualmente carpetas de trabajo, proyectos, bases de datos o archivos PST autorizados. No se exploran discos completos ni se garantiza detectar toda la información personal." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="2 · Elegí el destino y revisá el resumen" Style="{StaticResource SectionTitle}"/><TextBlock Text="Usá un medio que conservarás al reinstalar Windows. Se comprobarán espacio, escritura y riesgos del destino." Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/><TextBox Text="{Binding Destination, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Destino seleccionado"/><WrapPanel Margin="0,8,0,0"><Button Content="Elegir destino…" Command="{Binding DestinationCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="3 · Revisar y crear respaldo…" Command="{Binding CreateCommand}"/></WrapPanel></StackPanel></Border>
   </StackPanel></TabItem>
   <TabItem Header="Restaurar respaldo"><StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="1 · Abrí y verificá el respaldo" Style="{StaticResource SectionTitle}"/><TextBlock Text="Seleccioná la carpeta que contiene manifest.json. Se comprobarán su versión, las rutas y los hashes antes de recuperar archivos." Style="{StaticResource SecondaryText}"/><Button Content="Seleccionar carpeta y verificar…" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Margin="0,12,0,12"/><TextBox Text="{Binding BackupRoot, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Carpeta del respaldo"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="2 · Seleccioná categorías recuperables" Style="{StaticResource SectionTitle}"/><DataGrid ItemsSource="{Binding Recoverable}" Height="200" AutoGenerateColumns="False" IsReadOnly="False" IsEnabled="{Binding Ready}" Margin="0,12,0,0" AutomationProperties.Name="Categorías recuperables"><DataGrid.Columns><DataGridCheckBoxColumn Header="Incluir" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="64"/><DataGridTextColumn Header="Categoría" Binding="{Binding Name}" IsReadOnly="True" Width="160"/><DataGridTextColumn Header="Bytes verificados" Binding="{Binding Bytes, StringFormat=N0}" IsReadOnly="True" Width="140"/><DataGridTextColumn Header="Archivos" Binding="{Binding Files}" IsReadOnly="True" Width="85"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" IsReadOnly="True" Width="180"/><DataGridTextColumn Header="Advertencias" Binding="{Binding Warning}" IsReadOnly="True" Width="320"/></DataGrid.Columns></DataGrid></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="3 · Revisá rutas y conflictos" Style="{StaticResource SectionTitle}"/><Button Content="Previsualizar rutas y conflictos" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/><DataGrid ItemsSource="{Binding RestoreItems}" Height="220" AutoGenerateColumns="False" Margin="0,10,0,12" AutomationProperties.Name="Previsualización de restauración"><DataGrid.Columns><DataGridTextColumn Header="Archivo del respaldo" Binding="{Binding File.BackupPath}" Width="300"/><DataGridTextColumn Header="Destino actual" Binding="{Binding Destination}" Width="400"/><DataGridCheckBoxColumn Header="Existe" Binding="{Binding Conflict}" Width="80"/></DataGrid.Columns></DataGrid><TextBlock Text="Los archivos existentes se conservan por defecto. Reemplazarlos requiere confirmación expresa." Style="{StaticResource SecondaryText}"/><TextBlock Text="Cómo resolver los conflictos" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Policies}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SelectedPolicy}" IsEnabled="{Binding Ready}"/><Button Content="4 · Confirmar y restaurar selección…" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
   </StackPanel></TabItem>
  </TabControl>
  <Border Margin="0,0,0,16"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Details}" Value=""/><Condition Binding="{Binding ResultPath}" Value=""/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="Resumen e informe" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Details}" LineHeight="22" Margin="0,8,0,14"/><TextBlock Text="Carpeta o informe de la última operación" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/><TextBox Text="{Binding ResultPath, Mode=OneWay}" IsReadOnly="True"/></StackPanel></Border>
  <Border Style="{StaticResource WarningPanel}"><DockPanel><local:AppIcon Kind="Warning" Foreground="{DynamicResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Top"/><TextBlock Text="Antes de formatear: comprobá el estado completo y verificado, revisá los errores y confirmá que el destino sobrevivirá al borrado. Los respaldos no están cifrados." LineHeight="22"/></DockPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
