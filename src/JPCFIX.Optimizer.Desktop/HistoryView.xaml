<UserControl x:Class="JPCFIX.Optimizer.Desktop.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="{StaticResource PagePadding}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,16"><TextBlock Text="Historial de operaciones" Style="{StaticResource PageTitle}"/><TextBlock Text="Operaciones persistidas por el ejecutor. Revisá el resultado antes de revertir o recuperar." Style="{StaticResource SecondaryText}"/><WrapPanel Margin="0,10,0,0"><Button Content="Actualizar historial" Command="{Binding HistoryCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Revertir / recuperar selección…" Command="{Binding RollbackCommand}" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource InfoPanel}" Margin="0,0,0,16"><TextBlock Text="Preparado / Requiere recuperación indican operaciones incompletas. La reversión exige confirmación y solicita UAC. Las fechas conservan su zona original."/></Border>
  <DataGrid Grid.Row="2" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TableHeight}}" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedChange}" AutoGenerateColumns="False"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns><DataGridTextColumn Header="Fecha y zona" Binding="{Binding CreatedAt, StringFormat=g}" Width="180"/><DataGridTemplateColumn Header="Resultado" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource OperationBadge}"><TextBlock Text="{Binding Status, Converter={StaticResource ChangeStatusText}}" FontSize="12"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*" MinWidth="260"/><DataGridTextColumn Header="Operación" Binding="{Binding Id}" Width="290"/><DataGridTextColumn Header="Plan original" Binding="{Binding Original}" Width="290"/><DataGridTextColumn Header="Plan aplicado" Binding="{Binding Target}" Width="290"/></DataGrid.Columns></DataGrid>
  <TextBlock Grid.Row="2" VerticalAlignment="Top" Text="Sin actividad registrada"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </Grid></ScrollViewer>
</UserControl>
